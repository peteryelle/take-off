# Take-off — Environment Variables
#
# Copy this file to .env.local for local dev (Netlify CLI loads .env.local
# automatically — see DEVELOPER.md). Never commit .env.local or .env.
#
# See DEVELOPER.md § Environment Variables for the full table (purpose, who
# uses each one, where to get a local value, and whether it's a secret).

# ── Supabase ──────────────────────────────────────────────────────
# Point these at EITHER your local `supabase start` stack (get values from
# `npx supabase status`) OR the shared remote "development" branch
# (Project Settings → API in the Supabase dashboard, branch = development).
# Never point local dev at the production project.

# Server + browser (served to the browser via /config.js — safe, see auth.js)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only — NEVER expose to the browser or commit a real value
SUPABASE_SERVICE_KEY=your-service-role-or-secret-key

# ── Anthropic ─────────────────────────────────────────────────────
# Server-only. Vision calls in the pass-* functions (symbol/device detection).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Resend (transactional email) ─────────────────────────────────
# Server-only. Used by netlify/functions/utils/email.js for org-invite email.
# Optional for most local dev — only needed if you're testing invite flows.
RESEND_API_KEY=re_your-key-here
RESEND_FROM=Take-off <noreply@yourdomain.com>
